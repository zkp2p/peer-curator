INDEXER_GRAPHQL_URL=https://indexer.zkp2p.xyz/v1/graphql
# Optional. Without it, public access is automatically rate-limited.
INDEXER_API_KEY=
RUN_COMMAND=calculate
CHAIN_ID=8453
V2_HISTORY_ENVIRONMENT=prod
RPC_URL=

GROUPS_CONFIG_PATH=config/groups.json
# Optional desired-membership overrides. Leave empty outside test environments.
PINNED_MEMBERS_JSON=

EXECUTE=false
GROUP_ADMIN_PRIVATE_KEY=
REQUIRE_ZERO_RESOLVER=true
ALLOW_INITIAL_SEED=false

BATCH_SIZE=100
SNAPSHOT_CONFIRMATIONS=20
MAX_PLANNED_ADDS=1500
MAX_EXECUTED_ADDS_PER_RUN=1000
MAX_TOTAL_REMOVALS=100
MAX_REMOVAL_WALLETS=50
ALLOW_MIGRATION_REMOVALS=false
MAX_REMOVAL_BPS_PER_GROUP=500
REQUEST_TIMEOUT_MS=20000
LOG_LEVEL=info

# One-time Top Chargeback Merchants initialization. These commands are not
# part of the recurring historical-taker cron.
MERCHANT_REGISTRY_ADDRESS=
MERCHANT_GROUP_CONFIG_PATH=config/merchant-group.json
MERCHANT_GROUP_NAME=Top Chargeback Merchants
ALLOW_MERCHANT_GROUP_CREATION=false
