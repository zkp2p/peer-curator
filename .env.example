INDEXER_GRAPHQL_URL=https://indexer.zkp2p.xyz/v1/graphql
# Optional. Without it, public access is automatically rate-limited.
INDEXER_API_KEY=
RUN_COMMAND=calculate
CHAIN_ID=8453
RPC_URL=

GROUPS_CONFIG_PATH=config/groups.json
# Optional desired-membership overrides. Leave empty outside test environments.
PINNED_MEMBERS_JSON=

EXECUTE=false
GROUP_ADMIN_PRIVATE_KEY=
REQUIRE_ZERO_RESOLVER=true
ALLOW_INITIAL_SEED=false

BATCH_SIZE=100
SNAPSHOT_CONFIRMATIONS=0
SNAPSHOT_MAX_ATTEMPTS=20
SNAPSHOT_RETRY_DELAY_MS=250
MAX_PLANNED_ADDS=25000
MAX_EXECUTED_ADDS_PER_RUN=3000
MAX_TOTAL_REMOVALS=100
MAX_REMOVAL_WALLETS=50
ALLOW_MIGRATION_REMOVALS=false
MAX_REMOVAL_BPS_PER_GROUP=500
REQUEST_TIMEOUT_MS=20000
LOG_LEVEL=info
