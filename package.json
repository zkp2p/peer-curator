{
  "name": "@zkp2p/peer-curator",
  "version": "0.1.0",
  "private": true,
  "description": "Calculates and reconciles Peer-curated groups into AddressGroupRegistry",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "calculate": "tsx src/cli.ts calculate",
    "verify": "tsx src/cli.ts verify",
    "compare:local": "tsx scripts/compare-local.ts",
    "hash-wallets": "tsx scripts/hash-wallet-list.ts",
    "plan": "tsx src/cli.ts plan",
    "sync": "tsx src/cli.ts sync",
    "merchant:calculate": "tsx src/merchantCli.ts calculate",
    "merchant:create": "tsx src/merchantCli.ts create",
    "merchant:plan": "tsx src/merchantCli.ts plan",
    "merchant:sync": "tsx src/merchantCli.ts sync",
    "check:upstream": "tsx scripts/check-upstream.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@zkp2p/contracts-v2": "0.3.0",
    "dotenv": "16.6.1",
    "pino": "10.3.1",
    "viem": "2.55.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "4.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
